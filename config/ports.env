# Ports of the integrated stack, all on 127.0.0.1 (PLAN §3.3, docs/contracts/m1.md §0). Every port shifts by
# WL_PORT_OFFSET (build-phase tests: +100 for real components, +200 for the body's fakes).
WL_PORT_OFFSET=${WL_PORT_OFFSET:-0}
GROOT_PORT=5550                 # GR00T PolicyServer 1 (P4)
GROOT_PORT_2=5552
SONIC_INPUT_PORT=5556           # SONIC zmq_manager input; wl-body (P3) is the ONLY binder
SONIC_DEBUG_PORT=5557           # deploy g1_debug (P2)
EGO_CAMERA_PORT=5565            # P1 camera, gear_sonic sensor_server msgpack (5555 is DCGM's; never use it)
P1_REP_PORT=5600                # P1 WorldRPC (REP)
P1_PUB_PORT=5601                # P1 gt.pose / gt.event
P1_FRAMES_PORT=5602             # P1 frame.tp / VizCams frames
BODY_CTL_PORT=5610              # wl-body ROUTER
BODY_EVT_PORT=5611              # wl-body PUB body.event / body.state
BODY_HALT_PORT=5612             # wl-body halt lane (PULL) -- M2b; M1's body has no halt lane yet
NAV_BRIDGE_PORT=5620            # nav2/ros_bridge.py REP (go_to backend nav2)
UI_PORT=8765
