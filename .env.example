# Copy to .env (gitignored) or ~/.config/ludo-g1/secrets.env and fill in. Key names only; never commit values.
# The runtime reads, in order: $WORLDLINE_ENV, <repo>/.env, ~/.config/ludo-g1/secrets.env (PLAN 4.1).
# ludo-runtime/.env is never read or copied.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
HF_TOKEN=
